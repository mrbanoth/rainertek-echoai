# =================================================================
# RainerTek EchoAI — Environment Configuration
# =================================================================

# 1. Sarvam AI Voice & Speech API Key (Required for real-time Voice synthesis & STT)
# Obtain your API key at: https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# 2. Designated Hotline / Telephony Phone Number (Displayed to callers)
# Format: +91 xxxxx xxxxx or +1 (xxx) xxx-xxxx
NEXT_PUBLIC_HOTLINE_NUMBER=+91 80 4718 9000

# 3. Default Voice & Language
NEXT_PUBLIC_DEFAULT_VOICE=meera
NEXT_PUBLIC_DEFAULT_LANG=en-IN

# 4. Optional: OpenAI / Groq / Anthropic for advanced LLM reasoning (Falls back to Sarvam Chat or smart rule engine if empty)
OPENAI_API_KEY=
